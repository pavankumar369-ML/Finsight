# Copy this file to .env and fill in a key to switch the assistant from offline mode to a real LLM.
# Any OpenAI-compatible API works. Pick ONE block.

# Groq (free tier, fast) — https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Google Gemini (free tier) — https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash

# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Change this in production
FINSIGHT_SECRET=dev-secret-change-me-in-production-please
