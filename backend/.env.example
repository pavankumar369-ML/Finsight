# Copy to .env for local overrides. Nothing here is required to run FinSight locally.

# Signing key for login sessions. Set a long random value in production (Render generates one).
FINSIGHT_SECRET=dev-secret-change-me-in-production-please

# Admin access to Metrics controls (retrain, load test, users). Comma-separated emails, case-insensitive.
ADMIN_EMAILS=

# Optional: Postgres connection string (e.g. Neon). Leave unset to use the local SQLite file.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
